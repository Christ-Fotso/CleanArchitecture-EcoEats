{
  "name": "ecoeats-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test --config=tests/playwright.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:api": "powershell -File ./tests/test-api.ps1",
    "test:seed": "docker exec ecoeats-backend npx prisma db seed",
    "test:full": "npm run test:seed && npm run test:api && npm run test:e2e",
    "stack:up": "docker-compose up -d",
    "stack:down": "docker-compose down",
    "stack:logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1"
  }
}
